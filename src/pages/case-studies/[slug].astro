---
import { getCollection, render } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseStudyRoot from '../../components/CaseStudyRoot';
import { MdxLink } from '../../components/core/links/MdxLink';

export async function getStaticPaths() {
  const caseStudies = await getCollection('case-studies');
  return caseStudies.map((cs) => ({
    params: { slug: cs.data.slug },
    props: { cs },
  }));
}

const { cs } = Astro.props;
const { Content } = await render(cs);

let logoSrc: string | undefined;
if (cs.data.logo) {
  const img = await getImage({ src: cs.data.logo, width: 400, format: 'webp' });
  logoSrc = img.src;
}

// Attachments are stored next to the entry's index.mdx (`./case-study.pdf`, or a bare
// filename from a CMS upload). Used as a raw href they pointed at
// /case-studies/<slug>/case-study.pdf, which the build never emits — resolve them
// through Vite instead so the file is bundled and gets a real URL.
const attachmentFiles = import.meta.glob<string>('/src/content/case-studies/**/*.pdf', {
  query: '?url',
  import: 'default',
  eager: true,
});
const rawAttachment = cs.data.attachment ?? cs.data.attachments;
let attachment: string | undefined;
if (rawAttachment) {
  if (/^(https?:)?\/\//.test(rawAttachment) || rawAttachment.startsWith('/')) {
    attachment = rawAttachment;
  } else {
    const entryDir = `/${cs.filePath}`.replace(/\/[^/]+$/, '');
    const key = new URL(rawAttachment, `file://${entryDir}/`).pathname;
    attachment = attachmentFiles[key];
    if (!attachment) {
      throw new Error(`Case study "${cs.id}": attachment "${rawAttachment}" not found at ${key}`);
    }
  }
}

const path = `/case-studies/${cs.data.slug}/`;
const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Case Studies', href: '/case-studies/' },
  { label: cs.data.client, href: path },
];
---

<BaseLayout
  title={cs.data.title}
  description={cs.data.description ?? `BrandGlue case study: ${cs.data.client}`}
  path={path}
  type="article"
>
  <CaseStudyRoot
    client:load
    caseStudy={{
      client: cs.data.client,
      title: cs.data.title,
      slug: cs.data.slug,
      logoSrc,
      attachment,
    }}
    crumbs={crumbs}
  >
    <Content components={{ a: MdxLink }} />
  </CaseStudyRoot>
</BaseLayout>
